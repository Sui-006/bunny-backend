# 复制本文件为 .env 并填写

# 服务端口
PORT=3001

# Supabase 数据库（PostgreSQL）
SUPABASE_URL=
SUPABASE_KEY=

# --- 认证（单用户 Owner 模型） ---
# 首次启动自动创建唯一 owner。可指定 owner 邮箱（注册/登录用）。
OWNER_EMAIL=
# 为 false 时要求所有业务 API 携带 Bearer token（隐式 owner 关闭）；默认 true 兼容无登录 UI 的前端。
ALLOW_IMPLICIT_OWNER=true

# --- 前端跨域 ---
# 生产部署填前端地址（多个用逗号分隔）；留空则允许所有来源（本地/同源）
FRONTEND_URL=

# --- AI 厂商（按模型名自动路由） ---

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1   # 默认值，可省略

# OpenAI
OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com/v1       # 默认值，可省略；走中转就填中转地址

# Anthropic（Claude，协议与 OpenAI 不同）
ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com    # 默认值，可省略；走中转就填中转地址
# ANTHROPIC_PROTOCOL=anthropic                        # Claude 中转若是 OpenAI 兼容协议，改成 openai-compat

# 默认模型
DEFAULT_MODEL=deepseek-chat

# Bark 推送默认地址（AI 主动消息 / 普通回复通知推送到手机）
# 格式：https://api.day.app/{你的 device token}
BARK_URL=

# 兼容别名：API_KEY / API_BASE_URL 仍可作为 DeepSeek 的 Key 和地址

# 也可在网页「API 设置」里填写 key / 中转地址 / 签名（存到 Supabase app_settings 表，优先于这里）；
# 环境变量作为兜底/默认。

# 本地无 Key 时置 true，返回假回复用于调试
MOCK_AI=false

# --- 对象存储（文件上传，可选） ---
# 未配置时文件落本地 public/uploads（仅本地调试）；生产建议配 Supabase Storage / Cloudflare R2 / S3。
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=

# 复制本文件为 .env 并填写

# 服务端口
PORT=3001

# Supabase 数据库
SUPABASE_URL=
SUPABASE_KEY=

# --- AI 厂商（按模型名自动路由） ---

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1   # 默认值，可省略

# OpenAI
OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com/v1       # 默认值，可省略

# Anthropic（Claude，协议与 OpenAI 不同）
ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com    # 默认值，可省略

# 默认模型
DEFAULT_MODEL=deepseek-chat

# 兼容别名：API_KEY / API_BASE_URL 仍可作为 DeepSeek 的 Key 和地址

# 本地无 Key 时置 true，返回假回复用于调试
MOCK_AI=false

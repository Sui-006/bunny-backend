# 复制本文件为 .env 并填写

# 服务端口
PORT=3001

# Supabase 数据库
SUPABASE_URL=
SUPABASE_KEY=

# --- AI 厂商（按模型名自动路由） ---

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1   # 默认值，可省略

# OpenAI
OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com/v1       # 默认值，可省略；走中转就填中转地址

# Anthropic（Claude，协议与 OpenAI 不同）
ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com    # 默认值，可省略；走中转就填中转地址
# ANTHROPIC_PROTOCOL=anthropic                        # Claude 中转若是 OpenAI 兼容协议，改成 openai-compat

# 默认模型
DEFAULT_MODEL=deepseek-chat

# 兼容别名：API_KEY / API_BASE_URL 仍可作为 DeepSeek 的 Key 和地址

# 也可在网页「API 设置」里填写 key / 中转地址 / 签名（存到 Supabase app_settings 表，优先于这里）；
# 环境变量作为兜底/默认。

# 本地无 Key 时置 true，返回假回复用于调试
MOCK_AI=false
